<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RynthCore.DesktopLog\RynthCore.DesktopLog.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Build-Installer.ps1 publishes this project self-contained for the bundle (see BUILD.md). -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>RynthCore.Injector</RootNamespace>
    <AssemblyName>RynthCore.Injector</AssemblyName>
    <Platforms>x86</Platforms>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Install-location resolver (installer-chosen RynthCore / RynthSuite folders). -->
    <Compile Include="..\RynthCore.App\RynthInstallPaths.cs" Link="Shared\RynthInstallPaths.cs" />
  </ItemGroup>

</Project>
