<Project>
  <!--
    RynthCore plugin manifests, generated from the plugin's csproj.

    A plugin opts in by setting RynthPluginMinEngineApi (the oldest engine API it runs on: its
    highest API use that is NOT behind a Has*/version check). The build then
      1. writes obj\...\rynth-plugin.json from the csproj:
           name          RynthPluginName          (default: AssemblyName without "RynthCore.Plugin.")
           version       Version                  (Publish-Update.ps1 passes -p:Version=yyyy.m.d.n)
           minEngineApi  RynthPluginMinEngineApi
           maxEngineApi  RynthPluginMaxEngineApi  (optional; leave unset - the table is append-only)
           dependencies  @(RynthPluginDependency)  Include = plugin name, metadata MinVersion, Optional="true"
           author        RynthPluginAuthor        (default: Authors, then Company)
           description   RynthPluginDescription   (default: Description)
           homepage      RynthPluginHomepage      (default: PackageProjectUrl)
           license       RynthPluginLicense       (default: PackageLicenseExpression)
      2. adds [assembly: RynthPluginManifest(minEngineApi)], which RynthPluginBase.MinimumApiVersion
         defaults to (the plugin's own runtime check, which also covers engines from before
         manifests), and generates RynthPluginInfo (Name, Version, MinEngineApi constants) in the
         plugin's root namespace for code that wants them;
      3. embeds the JSON in the compiled assembly as a Windows resource (RCDATA
         "RYNTH_PLUGIN_MANIFEST"). NativeAOT copies the assembly's Windows resources into the
         native DLL, so the published plugin carries it too. The engine and the launcher read it
         from the file without loading the DLL (RynthCore.PluginSdk.Manifest.PluginManifestReader).

    Example:
      <RynthPluginMinEngineApi>71</RynthPluginMinEngineApi>
      <ItemGroup><RynthPluginDependency Include="RynthAi" Optional="true" /></ItemGroup>

    RynthPluginManifest=false turns it off. A PackageReference to RynthCore.PluginSdk imports this
    file by itself (build\); a ProjectReference needs an Import (RynthSuite\Plugins\Directory.Build.targets).
  -->

  <PropertyGroup>
    <!-- The engine API this SDK knows; tools\PluginManifestTests checks it equals PluginContractVersion.Current. -->
    <RynthCoreSdkApiVersion>79</RynthCoreSdkApiVersion>
    <_RynthPluginManifestOn Condition="'$(RynthPluginMinEngineApi)' != '' and '$(RynthPluginManifest)' != 'false'">true</_RynthPluginManifestOn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_RynthPluginManifestOn)' == 'true'">
    <RynthPluginName Condition="'$(RynthPluginName)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(AssemblyName)', '^RynthCore\.Plugin\.', ''))</RynthPluginName>
    <RynthPluginAuthor Condition="'$(RynthPluginAuthor)' == '' and '$(Authors)' != '' and '$(Authors)' != '$(AssemblyName)'">$(Authors)</RynthPluginAuthor>
    <RynthPluginAuthor Condition="'$(RynthPluginAuthor)' == ''">$(Company)</RynthPluginAuthor>
    <RynthPluginDescription Condition="'$(RynthPluginDescription)' == ''">$(Description)</RynthPluginDescription>
    <RynthPluginHomepage Condition="'$(RynthPluginHomepage)' == ''">$(PackageProjectUrl)</RynthPluginHomepage>
    <RynthPluginLicense Condition="'$(RynthPluginLicense)' == ''">$(PackageLicenseExpression)</RynthPluginLicense>
    <_RynthPluginManifestJson>$(IntermediateOutputPath)rynth-plugin.json</_RynthPluginManifestJson>
    <_RynthPluginManifestEmbedded>$(IntermediateOutputPath)rynth-plugin.embedded</_RynthPluginManifestEmbedded>
    <_RynthPluginInfoSource>$(IntermediateOutputPath)RynthPluginInfo.g.cs</_RynthPluginInfoSource>
  </PropertyGroup>

  <!-- [assembly: RynthPluginManifest(min)]: RynthPluginBase.MinimumApiVersion's default, so the
       plugin's own check matches its manifest without any code in the plugin. -->
  <ItemGroup Condition="'$(_RynthPluginManifestOn)' == 'true'">
    <AssemblyAttribute Include="RynthCore.PluginSdk.RynthPluginManifestAttribute">
      <_Parameter1>$(RynthPluginMinEngineApi)</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>

  <UsingTask TaskName="RynthWritePluginManifest" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.IO;
using System.Text;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class RynthWritePluginManifest : Task
{
    [Required] public string Name { get; set; }
    public string Version { get; set; }
    [Required] public string MinEngineApi { get; set; }
    public string MaxEngineApi { get; set; }
    [Required] public string SdkApiVersion { get; set; }
    public string Author { get; set; }
    public string Description { get; set; }
    public string Homepage { get; set; }
    public string License { get; set; }
    public ITaskItem[] Dependencies { get; set; }
    public string RootNamespace { get; set; }
    [Required] public string JsonPath { get; set; }
    [Required] public string InfoSourcePath { get; set; }

    public override bool Execute()
    {
        uint min, max = 0, sdk;
        if (!uint.TryParse(MinEngineApi.Trim(), out min) || min == 0)
        { Log.LogError("RynthPluginMinEngineApi must be a positive whole number (got '{0}').", MinEngineApi); return false; }
        if (!uint.TryParse(SdkApiVersion.Trim(), out sdk)) sdk = 0;
        if (sdk != 0 && min > sdk)
        { Log.LogError("RynthPluginMinEngineApi {0} is newer than this SDK's engine API ({1}): update RynthCore.PluginSdk.", min, sdk); return false; }
        if (!string.IsNullOrWhiteSpace(MaxEngineApi) && (!uint.TryParse(MaxEngineApi.Trim(), out max) || max < min))
        { Log.LogError("RynthPluginMaxEngineApi '{0}' must be a whole number no lower than RynthPluginMinEngineApi ({1}).", MaxEngineApi, min); return false; }
        if (Name.Trim().Length == 0) { Log.LogError("RynthPluginName is empty."); return false; }

        var sb = new StringBuilder();
        sb.Append("{\n");
        sb.Append("  \"schema\": 1,\n");
        sb.Append("  \"name\": ").Append(Q(Name.Trim())).Append(",\n");
        if (!string.IsNullOrWhiteSpace(Version)) sb.Append("  \"version\": ").Append(Q(Version.Trim())).Append(",\n");
        sb.Append("  \"minEngineApi\": ").Append(min).Append(",\n");
        if (max != 0) sb.Append("  \"maxEngineApi\": ").Append(max).Append(",\n");
        sb.Append("  \"dependencies\": [");
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        bool first = true;
        foreach (ITaskItem d in Dependencies ?? new ITaskItem[0])
        {
            string dn = d.ItemSpec.Trim();
            if (dn.Length == 0 || !seen.Add(dn)) continue;
            if (string.Equals(dn, Name.Trim(), StringComparison.OrdinalIgnoreCase))
            { Log.LogError("RynthPluginDependency '{0}' is the plugin itself.", dn); return false; }
            string mv = (d.GetMetadata("MinVersion") ?? "").Trim();
            bool opt = string.Equals((d.GetMetadata("Optional") ?? "").Trim(), "true", StringComparison.OrdinalIgnoreCase);
            sb.Append(first ? "\n" : ",\n");
            first = false;
            sb.Append("    { \"name\": ").Append(Q(dn));
            if (mv.Length > 0) sb.Append(", \"minVersion\": ").Append(Q(mv));
            if (opt) sb.Append(", \"optional\": true");
            sb.Append(" }");
        }
        sb.Append(first ? "]" : "\n  ]");
        AppendOpt(sb, "author", Author);
        AppendOpt(sb, "description", Description);
        AppendOpt(sb, "homepage", Homepage);
        AppendOpt(sb, "license", License);
        sb.Append("\n}\n");
        WriteIfChanged(JsonPath, sb.ToString());

        string ns = string.IsNullOrWhiteSpace(RootNamespace) ? "" : RootNamespace.Trim();
        var cs = new StringBuilder();
        cs.Append("// <auto-generated>RynthCore.PluginSdk.targets, from the csproj's plugin manifest properties.</auto-generated>\n");
        if (ns.Length > 0) cs.Append("namespace ").Append(ns).Append(";\n\n");
        cs.Append("/// <summary>This plugin's manifest (embedded in the DLL as RYNTH_PLUGIN_MANIFEST).</summary>\n");
        cs.Append("internal static class RynthPluginInfo\n{\n");
        cs.Append("    public const string Name = ").Append(Q(Name.Trim())).Append(";\n");
        cs.Append("    public const string Version = ").Append(Q((Version ?? "").Trim())).Append(";\n");
        cs.Append("    /// <summary>The oldest engine API this plugin runs on (its manifest's minEngineApi).</summary>\n");
        cs.Append("    public const uint MinEngineApi = ").Append(min).Append(";\n");
        cs.Append("}\n");
        WriteIfChanged(InfoSourcePath, cs.ToString());
        return !Log.HasLoggedErrors;
    }

    private static void AppendOpt(StringBuilder sb, string key, string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        sb.Append(",\n  ").Append(Q(key)).Append(": ").Append(Q(value.Trim()));
    }

    private static void WriteIfChanged(string path, string text)
    {
        if (File.Exists(path) && File.ReadAllText(path) == text) return;
        Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(path)));
        File.WriteAllText(path, text, new UTF8Encoding(false));
    }

    private static string Q(string s)
    {
        var sb = new StringBuilder("\"");
        foreach (char c in s)
        {
            switch (c)
            {
                case '"': sb.Append("\\\""); break;
                case '\\': sb.Append("\\\\"); break;
                case '\n': sb.Append("\\n"); break;
                case '\r': sb.Append("\\r"); break;
                case '\t': sb.Append("\\t"); break;
                default:
                    if (c < 0x20) sb.Append("\\u").Append(((int)c).ToString("x4"));
                    else sb.Append(c);
                    break;
            }
        }
        return sb.Append('"').ToString();
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="RynthEmbedPluginManifest" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.ComponentModel;
using System.IO;
using System.Runtime.InteropServices;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class RynthEmbedPluginManifest : Task
{
    [Required] public string AssemblyPath { get; set; }
    [Required] public string ManifestPath { get; set; }
    [Required] public string MarkerPath { get; set; }

    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    private static extern IntPtr BeginUpdateResourceW(string pFileName, bool bDeleteExistingResources);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    private static extern bool UpdateResourceW(IntPtr hUpdate, IntPtr lpType, string lpName, ushort wLanguage, byte[] lpData, uint cb);
    [DllImport("kernel32.dll", SetLastError = true)]
    private static extern bool EndUpdateResourceW(IntPtr hUpdate, bool fDiscard);

    public override bool Execute()
    {
        if (!RuntimeInformation.IsOSPlatform(OSPlatform.Windows))
        {
            Log.LogWarning("RynthCore plugin manifest: embedding needs Windows (UpdateResource); '{0}' has no manifest.", AssemblyPath);
            return true;
        }
        byte[] data = File.ReadAllBytes(ManifestPath);
        IntPtr h = BeginUpdateResourceW(AssemblyPath, false);
        if (h == IntPtr.Zero)
        { Log.LogError("RynthCore plugin manifest: BeginUpdateResource failed on '{0}': {1}", AssemblyPath, new Win32Exception(Marshal.GetLastWin32Error()).Message); return false; }
        // RT_RCDATA (10), "RYNTH_PLUGIN_MANIFEST", language neutral.
        if (!UpdateResourceW(h, (IntPtr)10, "RYNTH_PLUGIN_MANIFEST", 0, data, (uint)data.Length))
        {
            int err = Marshal.GetLastWin32Error();
            EndUpdateResourceW(h, true);
            Log.LogError("RynthCore plugin manifest: UpdateResource failed on '{0}': {1}", AssemblyPath, new Win32Exception(err).Message);
            return false;
        }
        if (!EndUpdateResourceW(h, false))
        { Log.LogError("RynthCore plugin manifest: EndUpdateResource failed on '{0}': {1}", AssemblyPath, new Win32Exception(Marshal.GetLastWin32Error()).Message); return false; }
        File.WriteAllText(MarkerPath, DateTime.UtcNow.ToString("o"));
        Log.LogMessage(MessageImportance.Normal, "RynthCore plugin manifest embedded in {0}", AssemblyPath);
        return true;
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <!-- 1 + 2: the JSON and RynthPluginInfo, before compiling (RynthPluginInfo is compiled in). -->
  <Target Name="RynthGeneratePluginManifest" BeforeTargets="CoreCompile" Condition="'$(_RynthPluginManifestOn)' == 'true'">
    <RynthWritePluginManifest Name="$(RynthPluginName)" Version="$(Version)" MinEngineApi="$(RynthPluginMinEngineApi)"
                              MaxEngineApi="$(RynthPluginMaxEngineApi)" SdkApiVersion="$(RynthCoreSdkApiVersion)"
                              Author="$(RynthPluginAuthor)" Description="$(RynthPluginDescription)"
                              Homepage="$(RynthPluginHomepage)" License="$(RynthPluginLicense)"
                              Dependencies="@(RynthPluginDependency)" RootNamespace="$(RootNamespace)"
                              JsonPath="$(_RynthPluginManifestJson)" InfoSourcePath="$(_RynthPluginInfoSource)" />
    <ItemGroup>
      <Compile Include="$(_RynthPluginInfoSource)" />
      <FileWrites Include="$(_RynthPluginManifestJson);$(_RynthPluginInfoSource);$(_RynthPluginManifestEmbedded)" />
    </ItemGroup>
  </Target>

  <!-- 3: into the compiled assembly, before it is copied to bin or compiled by NativeAOT (ILC reads
       @(IntermediateAssembly)). Incremental: again only when the assembly or the JSON changed. -->
  <Target Name="RynthEmbedPluginManifest" AfterTargets="CoreCompile" Condition="'$(_RynthPluginManifestOn)' == 'true'"
          Inputs="@(IntermediateAssembly);$(_RynthPluginManifestJson)" Outputs="$(_RynthPluginManifestEmbedded)">
    <RynthEmbedPluginManifest AssemblyPath="@(IntermediateAssembly->'%(FullPath)')" ManifestPath="$(_RynthPluginManifestJson)"
                              MarkerPath="$(_RynthPluginManifestEmbedded)" />
  </Target>
</Project>
