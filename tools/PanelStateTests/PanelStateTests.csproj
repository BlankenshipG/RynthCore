<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for which window-layout file a client uses (src\RynthCore.Engine\UI\PanelStatePath.cs,
    compiled in): panel_state.<server>.<character>.txt from the launch context's ServerName and
    TargetCharacter, unsafe characters as "_", and the shared panel_state.txt when the character
    isn't known. No files, no ImGui. Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>PanelStateTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\UI\PanelStatePath.cs" Link="Engine\PanelStatePath.cs" />
  </ItemGroup>

</Project>
