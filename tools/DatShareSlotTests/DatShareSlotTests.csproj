<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for src\RynthCore.Engine\Compatibility\LazyImportSlotScanner.cs (2026-10-15):
    the 2025 ACClient.exe resolves kernel32!CreateFileW into a private slot on first use and opens
    its DAT files through it, so the DAT share hook has to find that slot as well as the import
    slots. Synthetic images cover the stub shape and the near misses that must not match; when the
    2025 client is on this PC (or RYNTH_ACCLIENT points at one) its real slot is checked too.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>DatShareSlotTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\Compatibility\LazyImportSlotScanner.cs" Link="Engine\LazyImportSlotScanner.cs" />
  </ItemGroup>

</Project>
