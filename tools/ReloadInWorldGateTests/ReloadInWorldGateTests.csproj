<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the in-world automatic hot-reload gate (2026-10-16):
    src\RynthCore.Engine\ReloadInWorldGate.cs. Automatic reloads wait while the player is
    in the world; manual / AllowInWorldAutoHotReload skip; leaving the world clears; a
    throwing stillHold never wedges. Clock and sleep are fakes.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ReloadInWorldGateTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\ReloadInWorldGate.cs" Link="Engine\ReloadInWorldGate.cs" />
  </ItemGroup>

</Project>
